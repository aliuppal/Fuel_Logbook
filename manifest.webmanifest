{
  "name": "Fuel Logbook",
  "short_name": "Fuel Log",
  "description": "Track your car's fuel average in km or miles, liters or gallons, and what you pay by fuel card or yourself.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0D1311",
  "theme_color": "#C8680A",
  "categories": ["utilities", "finance", "travel"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Add fill-up", "url": "./#add", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
